<?xml version="1.0" encoding="UTF-8"?>
<protocol name="astrea_toplevel_management_v1">
  <copyright>
    Copyright 2026 AstreaOS contributors
  </copyright>

  <interface name="astrea_toplevel_manager_v1" version="2">
    <description summary="authoritative Astrea toplevel list and actions">
      This private protocol publishes compositor-managed application toplevels.
      Version 1 has no window mutation requests. Handle events are grouped into
      bounded runtime cycles but share one revision, and manager done is the
      atomic completion boundary. Version 2 adds exact WindowId-handle actions
      whose completion is reported by this manager because a handle may close.
      A failed manager is terminal and does not disconnect other managers owned
      by the same client.
    </description>

    <enum name="error">
      <entry name="unauthorized" value="0"/>
      <entry name="manager_limit" value="1"/>
      <entry name="resource_limit" value="2"/>
    </enum>

    <enum name="failure_reason">
      <entry name="resource_limit" value="0"/>
      <entry name="publication_failure" value="1"/>
    </enum>

    <enum name="done_flags" bitfield="true">
      <entry name="truncated" value="1"/>
    </enum>

    <enum name="action">
      <entry name="activate" value="0"/>
      <entry name="minimize" value="1"/>
      <entry name="restore" value="2"/>
      <entry name="close" value="3"/>
    </enum>

    <enum name="action_result">
      <entry name="accepted" value="0"/>
      <entry name="no_change" value="1"/>
      <entry name="unavailable" value="2"/>
    </enum>

    <request name="destroy" type="destructor"/>

    <event name="toplevel">
      <arg name="id" type="new_id" interface="astrea_toplevel_v1"/>
    </event>

    <event name="done">
      <arg name="revision_hi" type="uint"/>
      <arg name="revision_lo" type="uint"/>
      <arg name="total" type="uint"/>
      <arg name="flags" type="uint" enum="done_flags"/>
    </event>

    <event name="failed">
      <description summary="terminal manager publication failure">
        The manager is terminal and receives no further events. This is a
        client-local failure and does not invalidate other managers owned by
        the same client.
      </description>
      <arg name="reason" type="uint" enum="failure_reason"/>
    </event>

    <event name="action_done" since="2">
      <description summary="completion of an exact toplevel action">
        An authorized version-2 request that reaches action dispatch receives
        exactly one completion from this manager. Invalid or non-actionable
        targets, duplicate pending tokens, and a manager at its pending-action
        bound receive unavailable without creating new pending state. These are
        semantic action results, not protocol or authentication failures. For
        close, accepted means only that the graceful close request was issued;
        disappearance is reported by the toplevel closed event.
      </description>
      <arg name="token_hi" type="uint"/>
      <arg name="token_lo" type="uint"/>
      <arg name="action" type="uint" enum="action"/>
      <arg name="result" type="uint" enum="action_result"/>
    </event>
  </interface>

  <interface name="astrea_toplevel_v1" version="2">
    <description summary="one compositor-managed Astrea toplevel">
      The handle is read-only. Its identifier is the stable decimal Typhon
      WindowId, and its lifetime is independent of the underlying compositor
      window object.
    </description>

    <enum name="kind">
      <entry name="xdg_toplevel" value="0"/>
      <entry name="x11_toplevel" value="1"/>
      <entry name="x11_dialog" value="2"/>
    </enum>

    <enum name="state" bitfield="true">
      <entry name="active" value="1"/>
      <entry name="minimized" value="2"/>
      <entry name="maximized" value="4"/>
      <entry name="fullscreen" value="8"/>
    </enum>

    <request name="destroy" type="destructor"/>

    <request name="activate" since="2">
      <arg name="token_hi" type="uint"/>
      <arg name="token_lo" type="uint"/>
    </request>

    <request name="minimize" since="2">
      <arg name="token_hi" type="uint"/>
      <arg name="token_lo" type="uint"/>
    </request>

    <request name="restore" since="2">
      <arg name="token_hi" type="uint"/>
      <arg name="token_lo" type="uint"/>
    </request>

    <request name="close" since="2">
      <arg name="token_hi" type="uint"/>
      <arg name="token_lo" type="uint"/>
    </request>

    <event name="identifier">
      <arg name="identifier" type="string"/>
    </event>
    <event name="app_id">
      <arg name="app_id" type="string"/>
    </event>
    <event name="title">
      <arg name="title" type="string"/>
    </event>
    <event name="pid">
      <arg name="pid" type="uint"/>
    </event>
    <event name="kind">
      <arg name="kind" type="uint" enum="kind"/>
    </event>
    <event name="state">
      <arg name="state" type="uint" enum="state"/>
    </event>
    <event name="focus_serial">
      <arg name="serial_hi" type="uint"/>
      <arg name="serial_lo" type="uint"/>
    </event>
    <event name="done">
      <arg name="revision_hi" type="uint"/>
      <arg name="revision_lo" type="uint"/>
    </event>
    <event name="closed"/>
  </interface>
</protocol>
