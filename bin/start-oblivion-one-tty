#!/usr/bin/env bash
set -euo pipefail

script_path="${BASH_SOURCE[0]}"
while [[ -L "$script_path" ]]; do
    script_dir="$(CDPATH= cd -- "$(dirname -- "$script_path")" && pwd)"
    link_target="$(readlink -- "$script_path")"
    if [[ "$link_target" == /* ]]; then
        script_path="$link_target"
    else
        script_path="$script_dir/$link_target"
    fi
done
script_dir="$(CDPATH= cd -- "$(dirname -- "$script_path")" && pwd)"

export OBLIVION_ONE_PROFILE="${OBLIVION_ONE_PROFILE:-release}"

# A second Typhon on another VT must not reuse a live instance's Wayland
# socket name: the name also keys the control socket. Keep the usual name
# (and session.log) for the first instance and suffix later ones by VT.
socket_in_use() {
    local lock="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/$1.lock"
    [[ -e "$lock" ]] || return 1
    ! flock -n "$lock" true 2>/dev/null
}
if [[ -z "${OBLIVION_ONE_SOCKET:-}" ]]; then
    OBLIVION_ONE_SOCKET="oblivion-one-tty"
    if socket_in_use "$OBLIVION_ONE_SOCKET"; then
        base="oblivion-one-tty${XDG_VTNR:+-vt$XDG_VTNR}"
        OBLIVION_ONE_SOCKET="$base"
        suffix=2
        while socket_in_use "$OBLIVION_ONE_SOCKET"; do
            OBLIVION_ONE_SOCKET="$base-$suffix"
            suffix=$((suffix + 1))
        done
        state_dir="${OBLIVION_ONE_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/oblivion-one}"
        export OBLIVION_ONE_LOG_FILE="${OBLIVION_ONE_LOG_FILE:-$state_dir/session-$OBLIVION_ONE_SOCKET.log}"
        # The shell's per-user endpoints (shell IPC, Paper control) take this
        # suffix so they do not collide with the primary session's shell.
        export ASTREA_SESSION_INSTANCE="${ASTREA_SESSION_INSTANCE:-$OBLIVION_ONE_SOCKET}"
        echo "start-oblivion-one-tty: oblivion-one-tty is in use; starting as $OBLIVION_ONE_SOCKET (log: $OBLIVION_ONE_LOG_FILE)" >&2
    fi
fi
export OBLIVION_ONE_SOCKET

# Prefer the stable Aether satellite build when available. An explicit binary
# always wins; otherwise retain the checkout-local fork as the fallback.
satellite_aether="/mnt/Aether/Desktop/GitHub/xwayland-satellite-target/release/xwayland-satellite"
satellite_fork="$script_dir/../../xwayland-satellite/target/release/xwayland-satellite"
if [[ -z "${TYPHON_XWAYLAND_SATELLITE_BINARY:-}" ]]; then
    if [[ -x "$satellite_aether" ]]; then
        export TYPHON_XWAYLAND_SATELLITE_BINARY="$(realpath -- "$satellite_aether")"
    elif [[ -x "$satellite_fork" ]]; then
        export TYPHON_XWAYLAND_SATELLITE_BINARY="$(realpath -- "$satellite_fork")"
    fi
fi

exec "$script_dir/start-oblivion-one" "$@"
