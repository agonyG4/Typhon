#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<'EOF'
Usage: qualify-direct-scanout PERF_LOG
       qualify-direct-scanout --self-test

Check the final perf native.scheduler record for the Stage 4 direct-scanout
qualification invariants.
EOF
}

metric() {
    local log_path="$1"
    local key="$2"
    awk -v key="$key" '
        $1 == "perf" && $2 == "native.scheduler" { record = $0 }
        END {
            if (record == "") exit 1
            count = split(record, fields, " ")
            prefix = key "="
            for (i = 1; i <= count; i++) {
                if (index(fields[i], prefix) == 1) {
                    print substr(fields[i], length(prefix) + 1)
                    exit 0
                }
            }
            exit 1
        }
    ' "$log_path"
}

check_log() {
    local log_path="$1"
    local failures=0

    printf '%-46s %s\n' "direct-scanout invariant" "result"
    printf '%-46s %s\n' "----------------------------------------------" "------"

    check_at_least() {
        local key="$1"
        local minimum="$2"
        local value
        value="$(metric "$log_path" "$key" 2>/dev/null || true)"
        if [[ "$value" =~ ^[0-9]+$ ]] && (( value >= minimum )); then
            printf '%-46s PASS (%s)\n' "$key >= $minimum" "$value"
        else
            printf '%-46s FAIL (%s)\n' "$key >= $minimum" "${value:-missing}"
            failures=$((failures + 1))
        fi
    }

    check_zero() {
        local key="$1"
        local value
        value="$(metric "$log_path" "$key" 2>/dev/null || true)"
        if [[ "$value" =~ ^[0-9]+$ ]] && (( value == 0 )); then
            printf '%-46s PASS\n' "$key == 0"
        else
            printf '%-46s FAIL (%s)\n' "$key == 0" "${value:-missing}"
            failures=$((failures + 1))
        fi
    }

    check_at_least direct_scanout_entries 1
    check_at_least direct_scanout_presentations 1
    check_at_least direct_scanout_replacements 1
    check_at_least direct_scanout_exits 1
    check_at_least direct_scanout_composited_fallbacks 1

    check_zero direct_scanout_duplicate_feedback
    check_zero direct_scanout_duplicate_settlement
    check_zero direct_scanout_early_release_prevented
    check_zero direct_scanout_same_buffer_resubmissions
    check_zero direct_scanout_worker_queue_overflow
    check_zero direct_scanout_callback_owner_leaks

    local active surface framebuffer epoch
    active="$(metric "$log_path" direct_scanout_active 2>/dev/null || true)"
    surface="$(metric "$log_path" direct_scanout_presented_surface 2>/dev/null || true)"
    framebuffer="$(metric "$log_path" direct_scanout_presented_framebuffer 2>/dev/null || true)"
    epoch="$(metric "$log_path" direct_scanout_presented_content_epoch 2>/dev/null || true)"
    if [[ "$active" == "false" ]] \
        && [[ "$surface" =~ ^[0-9]+$ && "$framebuffer" =~ ^[0-9]+$ && "$epoch" =~ ^[0-9]+$ ]] \
        && (( surface == 0 && framebuffer == 0 && epoch == 0 )); then
        printf '%-46s PASS\n' "inactive presented identity is empty"
    elif [[ "$active" == "true" ]] \
        && [[ "$surface" =~ ^[0-9]+$ && "$framebuffer" =~ ^[0-9]+$ && "$epoch" =~ ^[0-9]+$ ]] \
        && (( surface > 0 && framebuffer > 0 && epoch > 0 )); then
        printf '%-46s PASS\n' "active presented identity is complete"
    else
        printf '%-46s FAIL (%s,%s,%s,%s)\n' \
            "presented identity matches active state" \
            "${active:-missing}" "${surface:-missing}" "${framebuffer:-missing}" "${epoch:-missing}"
        failures=$((failures + 1))
    fi

    (( failures == 0 ))
}

self_test() {
    local fixture base active_line missing_field missing_positive
    fixture="$(mktemp)"
    trap "rm -f '$fixture'" EXIT
    base='perf native.scheduler direct_scanout_active=false direct_scanout_presented_surface=0 direct_scanout_presented_framebuffer=0 direct_scanout_presented_content_epoch=0 direct_scanout_entries=1 direct_scanout_presentations=1 direct_scanout_replacements=1 direct_scanout_exits=1 direct_scanout_composited_fallbacks=1 direct_scanout_duplicate_feedback=0 direct_scanout_duplicate_settlement=0 direct_scanout_early_release_prevented=0 direct_scanout_same_buffer_resubmissions=0 direct_scanout_worker_queue_overflow=0 direct_scanout_callback_owner_leaks=0'

    # The final record must be selected, not an earlier failed sample.
    printf '%s\n%s\n' \
        "${base/direct_scanout_replacements=1/direct_scanout_replacements=0}" "$base" >"$fixture"
    check_log "$fixture" >/dev/null
    printf '%s\n' "self-test: final-sample selection PASS"

    active_line="${base/direct_scanout_active=false/direct_scanout_active=true}"
    active_line="${active_line/direct_scanout_presented_surface=0/direct_scanout_presented_surface=7}"
    active_line="${active_line/direct_scanout_presented_framebuffer=0/direct_scanout_presented_framebuffer=8}"
    active_line="${active_line/direct_scanout_presented_content_epoch=0/direct_scanout_presented_content_epoch=9}"
    printf '%s\n' "$active_line" >"$fixture"
    check_log "$fixture" >/dev/null
    printf '%s\n' "self-test: active final-state identity PASS"

    expect_failure() {
        local name="$1"
        local line="$2"
        printf '%s\n' "$line" >"$fixture"
        if check_log "$fixture" >/dev/null 2>&1; then
            printf 'self-test: %s unexpectedly passed\n' "$name" >&2
            return 1
        fi
        printf 'self-test: %s failure PASS\n' "$name"
    }

    expect_failure "duplicate-feedback" \
        "${base/direct_scanout_duplicate_feedback=0/direct_scanout_duplicate_feedback=1}"
    expect_failure "duplicate-settlement" \
        "${base/direct_scanout_duplicate_settlement=0/direct_scanout_duplicate_settlement=1}"
    expect_failure "same-buffer-resubmission" \
        "${base/direct_scanout_same_buffer_resubmissions=0/direct_scanout_same_buffer_resubmissions=1}"
    expect_failure "callback-owner-leak" \
        "${base/direct_scanout_callback_owner_leaks=0/direct_scanout_callback_owner_leaks=1}"
    expect_failure "inactive-identity" \
        "${base/direct_scanout_presented_surface=0/direct_scanout_presented_surface=7}"

    missing_field="${base/ direct_scanout_presented_framebuffer=0/}"
    expect_failure "missing-field" "$missing_field"

    missing_positive="${base/direct_scanout_entries=1/direct_scanout_entries=0}"
    expect_failure "missing-positive-evidence" "$missing_positive"

    printf '%s\n' "self-test: PASS"
}

case "${1:-}" in
    --self-test)
        [[ "$#" -eq 1 ]] || { usage >&2; exit 2; }
        self_test
        ;;
    --help|-h)
        usage
        ;;
    "")
        usage >&2
        exit 2
        ;;
    *)
        [[ -f "$1" ]] || { printf 'qualify-direct-scanout: missing perf log: %s\n' "$1" >&2; exit 2; }
        check_log "$1"
        ;;
esac
